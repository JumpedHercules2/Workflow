# Telegram chat/canale destinazione (es: -1001234567890 per canali)
TELEGRAM_CHAT_ID=

# Attiva la pubblicazione automatica della risposta su TikTok (true/false).
# Tienilo a false all'inizio per revisionare a mano le risposte di "Giulia".
TIKTOK_AUTOREPLY_ENABLED=false

# Endpoint del tuo bridge che parla con TikTok (TikAPI, scraper custom, ecc.)
TIKTOK_BRIDGE_URL=https://tiktok-bridge.example.com
TIKTOK_BRIDGE_TOKEN=change_me
