            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"type\": \"{{ $json.type }}\",\n  \"profile\": \"{{ $json.profile }}\",\n  \"target_author\": \"{{ $json.author }}\",\n  \"item_id\": \"{{ $json.item_id }}\",\n  \"context_id\": \"{{ $json.context_id }}\",\n  \"reply\": {{ JSON.stringify($json.reply) }}\n}",
        "options": {
          "timeout": 15000
        }
      },
